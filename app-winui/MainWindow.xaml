<Window
    x:Class="NoiseReduction.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Noise Reduction">
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- при открытии фокус уходит сюда, иначе первый переключатель сразу в рамке -->
        <ContentControl x:Name="FocusSink" Width="0" Height="0" IsTabStop="True" AutomationProperties.AccessibilityView="Raw" />
        <Grid x:Name="TitleBar" Padding="16,0,140,0" Background="Transparent" FlowDirection="LeftToRight">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="AppImage" Width="16" Height="16" />
                <TextBlock Text="Noise Reduction" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <!-- средняя колонка не шире 760, крайние делят остаток поровну, контент всегда по центру -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="760*" MaxWidth="760" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Padding="20,4,20,20" Spacing="4">
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE720;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="GlobalTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="GlobalHelp" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MasterSwitch" Grid.Column="2" MinWidth="0" Toggled="MasterToggled" />
                    </Grid>
                </Border>
                <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" Closed="ErrorClosed" />
                <Grid Margin="2,16,0,4">
                    <TextBlock x:Name="MicrophonesHeading" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Name="RefreshButton" HorizontalAlignment="Right" Padding="8,4" Background="Transparent" BorderThickness="0" Click="RefreshClicked">
                        <Grid>
                            <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="14" />
                            <ProgressRing x:Name="RefreshRing" Width="14" Height="14" MinWidth="0" MinHeight="0" IsActive="False" />
                        </Grid>
                    </Button>
                </Grid>
                <StackPanel x:Name="MicrophoneList" Spacing="4" />
                <TextBlock x:Name="EmptyText" Margin="2,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="AppHeading" Margin="2,20,0,4" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xF2B7;" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock x:Name="LanguageLabel" Grid.Column="1" VerticalAlignment="Center" />
                        <ComboBox x:Name="LanguagePicker" Grid.Column="2" MinWidth="160" SelectionChanged="LanguageChanged" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock x:Name="WindowThemeLabel" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="WindowThemePicker" Grid.Column="2" MinWidth="160" SelectionChanged="ThemeChanged" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A7;" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock x:Name="TrayThemeLabel" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="TrayThemePicker" Grid.Column="2" MinWidth="160" SelectionChanged="ThemeChanged" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="StartupLabel" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TrayHelp" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2" MinWidth="0" Toggled="StartupToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE710;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NewMicrophonesLabel" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NewMicrophonesHelp" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="NewMicrophonesSwitch" Grid.Column="2" MinWidth="0" Toggled="NewMicrophonesToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEBA7;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="BatteryLabel" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="BatteryHelp" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="BatterySwitch" Grid.Column="2" MinWidth="0" Toggled="BatteryToggled" />
                    </Grid>
                </Border>
                <Border x:Name="UninstallCard" Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE74D;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="UninstallLabel" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="UninstallHelp" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="UninstallButton" Grid.Column="2" MinWidth="96" Click="UninstallClicked" />
                    </Grid>
                </Border>
                <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <HyperlinkButton x:Name="TagLink" Padding="6,2" FontSize="12" />
                    <HyperlinkButton x:Name="CommitLink" Padding="6,2" FontSize="12" />
                    <HyperlinkButton x:Name="SourceLink" Padding="6,2" FontSize="12" />
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
