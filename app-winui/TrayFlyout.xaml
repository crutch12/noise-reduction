<Window
    x:Class="NoiseReduction.WinUI.TrayFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Noise Reduction">
    <Grid x:Name="FlyoutRoot" KeyDown="FlyoutKeyDown">
        <Grid.Resources>
            <Style x:Key="FlyoutDetailsStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="FlyoutValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="16,10,16,10" ColumnSpacing="10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="FlyoutIcon" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock x:Name="GlobalLabel" Grid.Column="1" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <ToggleSwitch x:Name="GlobalSwitch" Grid.Column="2" MinWidth="0" Margin="0,0,-12,0" OnContent="" OffContent="" HorizontalAlignment="Right" Toggled="GlobalToggled" />
        </Grid>
        <StackPanel x:Name="MicrophoneRows" Grid.Row="1" Padding="16,12,16,12" Spacing="14" />
        <Grid Grid.Row="2" Padding="8,4,8,4" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Button x:Name="SettingsButton" Padding="8,6" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Click="SettingsClicked">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <TextBlock x:Name="SettingsLabel" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
