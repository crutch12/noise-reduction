<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier Condition="'$(Platform)' == 'arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'arm64'">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(Platform)' == 'arm64'">arm64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'arm64'">x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- выкидываем неиспользуемый код .NET, свой код не трогаем -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- обрезка выключает встроенный COM, а микрофоны Windows перечисляются через него -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <EnableMsixTooling>false</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../app/assets/NoiseReduction.ico</ApplicationIcon>
    <AssemblyName>NoiseReduction</AssemblyName>
    <Product>Noise Reduction</Product>
    <RootNamespace>NoiseReduction.WinUI</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- XAML находит часть типов WinUI во время работы, эти сборки обрезка не трогает -->
    <TrimmerRootAssembly Include="Microsoft.WinUI" />
  </ItemGroup>
  <ItemGroup>
    <!-- только нужные части Windows App SDK, без ИИ, поиска и виджетов, иначе установщик тяжелее на десятки мегабайт -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <Compile Include="../app/Core.cs" Link="Shared/Core.cs" />
    <Compile Include="../app/SecureControl.cs" Link="Shared/SecureControl.cs" />
    <Compile Include="../app/Comparison.cs" Link="Shared/Comparison.cs" />
    <Compile Include="../app/Localization.cs" Link="Shared/Localization.cs" />
    <Compile Include="../app/i18n/*.cs" LinkBase="Shared/i18n" />
    <Compile Include="../platform/Integration.cs" Link="Platform/Integration.cs" />
    <Compile Include="../platform/CaptureSessions.cs" Link="Platform/CaptureSessions.cs" />
    <Content Include="../app/assets/NoiseReduction.ico" Link="NoiseReduction.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../app/assets/Microphone.png" Link="Microphone.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
