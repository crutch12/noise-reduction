<Project Sdk="Microsoft.NET.Sdk">
  <!-- приложение для macOS и Linux, на Windows работает app-winui -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NoiseReduction</AssemblyName>
    <RootNamespace>NoiseReduction.Avalonia</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>../app/assets/NoiseReduction.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../app/Core.cs" Link="Shared/Core.cs" />
    <Compile Include="../app/Localization.cs" Link="Shared/Localization.cs" />
    <Compile Include="../app/i18n/*.cs" LinkBase="Shared/i18n" />
    <AvaloniaResource Include="../app/assets/NoiseReduction.ico" Link="Assets/NoiseReduction.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
</Project>
